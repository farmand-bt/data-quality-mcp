# Copy to .env (gitignored) for `make run-http` and `make docker-run`.
# Write every value unquoted: `docker --env-file` keeps quotes as part of the
# value, while `uv run --env-file` strips them.

# Required over HTTP: at least 32 characters of A-Z a-z 0-9 - . _ ~ + /
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DATA_QUALITY_MCP_TOKEN=

# On a public interface, the hostnames clients use (comma-separated). Unset,
# the host check is off there; on 127.0.0.1 the SDK's loopback check applies.
# DATA_QUALITY_MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:443

# Limits (defaults shown). Each must be a positive number; rows a whole number.
# DATA_QUALITY_MCP_MAX_FILE_SIZE_MB=50
# DATA_QUALITY_MCP_MAX_ROWS=500000
# DATA_QUALITY_MCP_MAX_XLSX_UNCOMPRESSED_MB=200
# DATA_QUALITY_MCP_MAX_INLINE_OUTPUT_MB=1
# DATA_QUALITY_MCP_MAX_HTTP_REQUEST_MB=16
