# Copy to .env (gitignored) for `make run-http` and `make docker-run`.
# Write every value unquoted: `docker --env-file` keeps quotes as part of the
# value, while `uv run --env-file` strips them.

# Over HTTP, set exactly one auth mode: this token, or the OAuth settings below.
# The token: at least 32 characters of A-Z a-z 0-9 - . _ ~ + /
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DATA_QUALITY_MCP_TOKEN=

# OAuth mode, instead of the token (docs/deployment.md). The issuer turns it on;
# the public URL and the owner are then required. None of these is secret.
# http is accepted only on localhost, 127.0.0.1 or [::1], for local tests.
# DATA_QUALITY_MCP_OAUTH_ISSUER=https://<tenant>.authkit.app
# DATA_QUALITY_MCP_PUBLIC_URL=https://<name>.onrender.com
# DATA_QUALITY_MCP_OAUTH_OWNER=user_...
# Optional; the default is the issuer plus /oauth2/jwks
# DATA_QUALITY_MCP_OAUTH_JWKS_URL=https://<tenant>.authkit.app/oauth2/jwks

# On a public interface, the hostnames clients use (comma-separated). Unset,
# the host check is off there; on 127.0.0.1 the SDK's loopback check applies.
# In OAuth mode it defaults to the public URL's host.
# DATA_QUALITY_MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:443

# Limits (defaults shown). Each must be a positive number; rows a whole number.
# DATA_QUALITY_MCP_MAX_FILE_SIZE_MB=50
# DATA_QUALITY_MCP_MAX_ROWS=500000
# DATA_QUALITY_MCP_MAX_XLSX_UNCOMPRESSED_MB=200
# DATA_QUALITY_MCP_MAX_INLINE_OUTPUT_MB=1
# DATA_QUALITY_MCP_MAX_HTTP_REQUEST_MB=16
